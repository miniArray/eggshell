# Worktrees
.worktree/

# Godot caches and build output
.godot/
# Script UID sidecars are generated by the editor; existing tracked UIDs stay tracked.
*.gd.uid
# Material sources are read as raw files by the offline builder, not texture resources.
/art/**/*.import
build/
export/

# Private imported packs stay outside Git; only the built-in Pantry pack ships.
/packs/*
!/packs/pantry/
*.eggpack
*.zip

# Nix
result
result-*
